{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "echo 'no dependencies'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/img/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.tiemnhaan.com"
        }
      ],
      "destination": "https://tiemnhaan.com/:path",
      "permanent": true
    },
    {
      "source": "/thuc-don",
      "destination": "/trai-nghiem",
      "permanent": true
    },
    {
      "source": "/thuc-don.html",
      "destination": "/trai-nghiem",
      "permanent": true
    },
    {
      "source": "/:lang(en|ja|ko|zh)?/tin-tuc/nha-an-sap-khai-truong-4-chi-nhanh",
      "destination": "/:lang/tin-tuc/nha-an-sap-khai-truong-5-chi-nhanh",
      "permanent": true
    },
    {
      "source": "/:lang(en|ja|ko|zh)?/tin-tuc/tuyen-dung-nhan-vien-4-chi-nhanh",
      "destination": "/:lang/tin-tuc/tuyen-dung-nhan-vien-5-chi-nhanh",
      "permanent": true
    },
    {
      "source": "/:lang(en|ja|ko|zh)?/tin-tuc/studio-ao-dai-va-goc-song-ao",
      "destination": "/:lang/tin-tuc/studio-ao-dai-va-goc-check-in",
      "permanent": true
    }
  ]
}
